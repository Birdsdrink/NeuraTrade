DATABASE_URL=postgresql://deriv:deriv@localhost:5432/deriv_ai
DERIV_WS_URL=wss://ws.binaryws.com/websockets/v3?app_id=1089

# ── AI Vision Providers (in priority order) ─────────────────────────────────
# Chart analysis uses these providers with automatic fallback.
# At least one provider must be configured.

# 1. Qwen2.5-VL-7B-Instruct via HuggingFace (primary — blocked if behind proxy)
#    Get a free token at https://huggingface.co/settings/tokens
HF_API_TOKEN=hf_your_token_here
QWEN_MODEL=Qwen/Qwen2.5-VL-7B-Instruct

# 2. Qwen2.5-VL-72B-Instruct via OpenRouter (secondary — very cheap, works through proxies)
#    Get a free API key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your_key_here
OPENROUTER_MODEL=qwen/qwen2.5-vl-72b-instruct

# 3. Google Gemini (tertiary — free tier limited to 20 req/day)
#    Get a key at https://aistudio.google.com/
AI_API_KEY=your_google_ai_key_here
AI_MODEL=gemini-3.6-flash
